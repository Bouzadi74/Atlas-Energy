ATLAS_ENV=local
ATLAS_LOG_LEVEL=INFO
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000
ATLAS_FRONTEND_ORIGIN=http://localhost:3000
ATLAS_AUTH_ENABLED=false
# Generate distinct values for deployed environments; never commit real keys.
ATLAS_API_READ_KEY=
ATLAS_API_WRITE_KEY=
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:55432/atlas
ATLAS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ATLAS_AIRFLOW_DB_PASSWORD=airflow-local-only
ATLAS_MLFLOW_TRACKING_URI=http://localhost:5000
ATLAS_DATA_ROOT=./data
ATLAS_SCENARIO_CONFIG_DIR=./configs/scenarios
ATLAS_MODEL_VERSION=pypsa-national-node-v1
ATLAS_DATA_VERSION=0e5327a2df73e087
ATLAS_OPTIMIZATION_CONFIG_PATH=./configs/optimization/national_baseline.yml
ATLAS_OPTIMIZATION_CALENDAR=planning
ATLAS_DBT_REFRESH_ENABLED=true
ATLAS_DBT_PROJECT_DIR=./dbt_atlas
ATLAS_DBT_PROFILES_DIR=./dbt_atlas
ATLAS_DBT_TIMEOUT_SECONDS=600
