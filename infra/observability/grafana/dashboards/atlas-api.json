      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(atlas_api_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "P95 request latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "atlas-prometheus"},
