{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-energy.local/schemas/scenario-requested-v1.schema.json",
  "title": "Atlas scenario requested event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "event_time", "producer", "key", "trace_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "scenario.requested"},
    "schema_version": {"const": 1},
    "event_time": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "key": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["scenario_id", "request_hash", "model_version", "data_version", "request"],
      "properties": {
        "scenario_id": {"type": "string"},
        "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "model_version": {"type": "string"},
        "data_version": {"type": "string"},
        "request": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}

